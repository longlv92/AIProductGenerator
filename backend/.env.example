# API Key/Secret của Private App giờ nhập trực tiếp trên giao diện web tool
# (màn hình kết nối), không cần khai báo sẵn ở đây nữa — backend lưu lại vào
# backend/data/store-connections.json sau khi xác thực thành công lần đầu.

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Tìm ảnh thật khớp sản phẩm — đăng ký miễn phí tại https://www.pexels.com/api/
PEXELS_API_KEY=

# Sinh nội dung sản phẩm bằng AI thật (Claude) — lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Kết nối store qua OAuth (thay cho tự tạo Private App mỗi store) — lấy API
# Key/Secret Key tại https://developers.sapo.vn/services/partners/api_clients
SAPO_OAUTH_CLIENT_ID=
SAPO_OAUTH_CLIENT_SECRET=

# URL backend đang chạy — dùng để dựng redirect_uri (${APP_URL}/api/oauth/callback).
# Đổi thành URL thật khi deploy; để mặc định localhost nếu chỉ tự kết nối từ máy này.
APP_URL=http://localhost:4000

# Ký cookie phiên đăng nhập theo từng store (session.ts) — bắt buộc khi nhiều người cùng dùng chung 1
# backend, để tránh việc ai đó gõ đúng URL store người khác đã kết nối là dùng được luôn. Random, giữ bí mật.
# Tạo nhanh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
